# Groq API Key (required by default): get at https://console.groq.com
GROQ_API_KEY=gsk_paste_groq_key_here

# Google Gemini API Key (optional, only needed when using Gemini): https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=paste_gemini_key_here

# Provider configuration for ASR (Speech-to-Text) and MT (Machine Translation)
# Default: Groq for both stages, no fallback
ASR_PROVIDER=groq
MT_PROVIDER=groq
MT_FALLBACK=none
MT_MAX_WAIT=3

# Groq Models
# GROQ_ASR_MODEL=whisper-large-v3
# GROQ_MT_MODEL=llama-3.3-70b-versatile
# GROQ_ASR_RPM=20
# GROQ_MT_RPM=30

# ASR Prompts for Groq Whisper (leave blank by default)
# GROQ_ASR_PROMPT=
# GROQ_ASR_PROMPT_VI=
# GROQ_ASR_PROMPT_JA=

# Translation Tone: auto (default) | polite | casual
# TONE=auto

# Gemini Models (optional when ASR_PROVIDER or MT_PROVIDER is gemini)
# ASR_MODEL=gemini-3.5-flash
# MT_MODEL=gemini-3.5-flash
# GEMINI_RPM=5
# GEMINI_THINKING=minimal

# Security & Limits
# ACCESS_PASSWORD=your_custom_password
# TRUST_PROXY=0
# AUTH_MAX_FAILS=5
# AUTH_FAIL_WINDOW_S=600
# AUDIO_PER_MIN=15
# MAX_AUDIO_S=30
# MIN_SPEECH_S=0.4
# MIN_SPEECH_DBFS=-48
